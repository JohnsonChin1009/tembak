# Copy to .env.local for local dev. Every value is optional locally:
# with nothing set, Tembak runs with an in-memory store, dev login, and a mock agent.

# memory | firestore
STORE=memory
# dev | firebase
AUTH_MODE=dev
# mock | gemini (defaults to gemini when GEMINI_API_KEY is set)
# AGENT_MODE=

# Gemini Developer API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Or use Vertex AI with the service account instead of an API key:
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-project
# GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FAST_MODEL=gemini-3.5-flash-lite

# Public URLs. Set APPS_URL to a separate subdomain in production (recommended).
APP_URL=http://localhost:3000
# APPS_URL=https://apps.example.com

# Comma-separated list, e.g. example.com. Empty = any Google account may sign in.
ALLOWED_EMAIL_DOMAINS=
# Maintainers of the shared Demo workspace (they can reset it). Comma-separated emails;
# in dev auth mode use "dev:<name>", e.g. DEMO_OWNER_EMAILS=dev:johnson
DEMO_OWNER_EMAILS=
# Random string, used to sign dev-mode sessions: openssl rand -base64 32
SESSION_SECRET=

# Firebase web config (Firebase console > Project settings > Your apps > Web app)
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=

# Shown in the "Add Google Sheet" dialog so users know whom to share with
SERVICE_ACCOUNT_EMAIL=
