# Copy to deploy.env (gitignored) and fill in. Read by scripts/setup-gcp.sh and scripts/deploy.sh.

PROJECT_ID=your-gcp-project-id
REGION=asia-southeast1
SERVICE=tembak

# Leave both empty on the first deploy: the script fills in the *.run.app URL.
# After mapping your domain, set e.g. APP_URL=https://app.example.com and
# APPS_URL=https://apps.example.com, then redeploy.
APP_URL=
APPS_URL=

# Firebase console > Project settings > General > Your apps > Web app config
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=your-gcp-project-id.firebaseapp.com

# Comma-separated, e.g. example.com. Empty = any Google account can sign in.
ALLOWED_EMAIL_DOMAINS=

GEMINI_MODEL=gemini-4-argon
GEMINI_FAST_MODEL=gemini-3.8-flash
# Set to true to use Vertex AI through the service account instead of an API key.
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_LOCATION=global
