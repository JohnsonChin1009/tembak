# Copy to deploy.env (gitignored) and fill in. Read by scripts/setup-gcp.sh and scripts/deploy.sh.

PROJECT_ID=your-gcp-project-id
REGION=asia-southeast1
SERVICE=tembak

# Leave both empty on the first deploy: the script fills in the *.run.app URL.
# After mapping your domain, set e.g. APP_URL=https://app.example.com and
# APPS_URL=https://apps.example.com, then redeploy.
APP_URL=
APPS_URL=

# Firebase console > Project settings > General > Your apps > Web app config
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=your-gcp-project-id.firebaseapp.com

# Comma-separated, e.g. example.com. Empty = any Google account can sign in.
ALLOWED_EMAIL_DOMAINS=

# Comma-separated emails of the people who maintain (and can reset) the Demo workspace.
DEMO_OWNER_EMAILS=

GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FAST_MODEL=gemini-3.5-flash-lite
# Set to true to use Vertex AI through the service account instead of an API key.
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_LOCATION=global

# 0 = scale to zero when idle (near-free; a few seconds' cold start on the first visit).
# Set to 1 shortly before a live demo for instant loads; it bills around the clock while set.
MIN_INSTANCES=0
MAX_INSTANCES=1
